# Copy to lab/.env (gitignored), uncomment and fill in only what you need. Every
# uncommented line is passed into the sandbox as an environment variable, so leave
# unused keys commented rather than empty. Use throwaway keys: they end up in the
# exported home under lab/out.

# Claude Code
#ANTHROPIC_API_KEY=

# Codex CLI
#OPENAI_API_KEY=

# Gemini CLI, Qwen Code
#GEMINI_API_KEY=
#GOOGLE_API_KEY=

# Copilot CLI (a GitHub token with the Copilot scope)
#GH_TOKEN=

# Aider, OpenCode and others via OpenRouter
#OPENROUTER_API_KEY=

# Build-time choices (read by docker compose when building)
#NPM_AGENTS=@anthropic-ai/claude-code @openai/codex @google/gemini-cli
#PIP_AGENTS=aider-chat
