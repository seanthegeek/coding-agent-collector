#!/bin/sh
# Fast checks before every commit. Enable once per clone with:
#   git config core.hooksPath .githooks
#
# Only quick operations belong here, currently the catalog drift check. The
# linters and tests run in CI; run them locally with the commands in
# AGENTS.md "Quality gates". Open Dependabot alerts are a release gate, not a
# commit gate; see "Conventions" in AGENTS.md.

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# staged_match PATTERN: true when a staged path matches the grep pattern.
staged_match() {
  printf '%s\n' "$staged" | grep -q "$1"
}

# Catalog copy and drift check.
if staged_match 'collectors/collect-agent-artifacts.sh\|collectors/Collect-AgentArtifacts.ps1\|analyzer/doubleagent/catalog.txt'; then
  if ! collectors/collect-agent-artifacts.sh --list | cmp -s - analyzer/doubleagent/catalog.txt; then
    echo "pre-commit: analyzer/doubleagent/catalog.txt is stale. Regenerate and stage it:" >&2
    echo "  collectors/collect-agent-artifacts.sh --list > analyzer/doubleagent/catalog.txt && git add analyzer/doubleagent/catalog.txt" >&2
    exit 1
  fi
  collectors/tests/catalog-sync.sh >/dev/null || { echo "pre-commit: catalog tables differ between the collectors; run collectors/tests/catalog-sync.sh" >&2; exit 1; }
fi

exit 0
